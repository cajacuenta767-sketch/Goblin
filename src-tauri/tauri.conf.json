{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GOBLIN",
  "version": "0.1.0",
  "identifier": "com.cajacuenta767.goblin",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://127.0.0.1:8800"
  },
  "app": {
    "windows": [
      {
        "title": "GOBLIN",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "url": "http://127.0.0.1:8800"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Development",
    "shortDescription": "IDE local con IA para ciberseguridad",
    "longDescription": "GOBLIN es un IDE de escritorio local con IA agentica para pentesting, con control del sistema y un modelo local sin censura via Ollama.",
    "linux": {
      "deb": {
        "depends": ["python3", "python3-venv", "libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
