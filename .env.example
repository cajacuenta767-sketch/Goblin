# === GOBLIN — plantilla de configuración ===
# Copia este archivo a ".env" y ajusta los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# --- Servidor ---
GOBLIN_HOST=127.0.0.1
GOBLIN_PORT=8800

# --- Ollama / modelo por defecto ---
OLLAMA_HOST=http://127.0.0.1:11434
GOBLIN_MODEL=hf.co/mradermacher/DeepHat-V1-7B-GGUF:Q4_K_M
GOBLIN_NUM_CTX=4096
GOBLIN_KEEP_ALIVE=10m

# --- Workspace y control de acceso ---
# GOBLIN_FULL_ACCESS=true  → la IA puede tocar cualquier ruta del usuario (control total, con aprobaciones)
# GOBLIN_FULL_ACCESS=false → la IA solo trabaja dentro de workspace/
GOBLIN_FULL_ACCESS=true
# GOBLIN_WORKSPACE=~/goblin-workspace   # (opcional) cambia la carpeta de trabajo

# --- Agente ---
GOBLIN_MAX_STEPS=15          # tope de iteraciones del agente (evita bucles del modelo 7B)
GOBLIN_SHELL_TIMEOUT=180     # segundos máximos por comando de shell

# --- Estado hacia la Polybar (Fase 9) ---
# GOBLIN escribe el target aquí; tu módulo de Polybar lo lee.
GOBLIN_STATE_DIR=~/.cache/goblin

# --- Gemini (Fase 2.5 — opcional, déjalo vacío por ahora) ---
GEMINI_API_KEY=
